#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
            ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
            tap-ms = <20>;
        };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp PRINTSCREEN
&kp Q       &kp L            &kp U       &kp COMMA   &kp PERIOD     &kp LEFT_ALT      &kp EQUAL      &kp F      &kp W     &kp R      &kp Y  &kp P
&kp E       &kp I            &kp A       &kp O       &kp MINUS      &kp LEFT_CONTROL  &kp SLASH      &kp K      &kp T     &kp N      &kp S  &lt 1 H
&kp Z       &kp X            &kp C       &kp V       &kp SEMICOLON  &kp SQT           &kp BACKSLASH  &kp G      &kp D     &kp M      &kp J  &lt 3 B
&kp GRAVE   &kp LEFT_WIN     &kp C_MENU  &kp LSHIFT  &kp SPACE      &lt 4 TAB         &kp BACKSPACE  &kp ENTER  &kp HOME  &lt 5 END
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 3   &trans    &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        SCROLL {
            bindings = <
&trans      &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        ARROW {
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans          &trans  &oled_mode  &oled_mode  &trans  &trans              &kp LC(UP_ARROW)  &trans               &trans
&trans  &trans  &trans  &trans          &trans  &trans      &trans      &trans  &kp LC(LEFT_ARROW)  &kp UP_ARROW      &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans          &trans  &trans      &trans      &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &trans
&trans  &trans  &trans  &kp LEFT_SHIFT  &trans  &trans      &trans      &trans  &trans              &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        NUM {
            bindings = <
&trans    &kp SCROLLLOCK
&kp N1    &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp N5       &trans  &trans   &kp NUMBER_6  &kp N7          &kp N8           &kp N9                &kp N0
&kp EXCL  &kp AT_SIGN     &kp HASH      &kp DOLLAR    &kp PERCENT  &trans  &trans   &kp CARET     &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans    &trans          &trans        &trans        &trans       &trans  &trans   &kp TILDE     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans    &trans          &trans        &trans        &trans       &trans  &kp DEL  &kp ENTER     &trans          &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        FUNCTION {
            bindings = <
&trans        &trans
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans   &trans   &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };

        BT {
            bindings = <
&trans          &trans
&kp LG(Q)       &kp LC(W)  &out OUT_USB  &out OUT_BLE  &out OUT_TOG  &trans  &trans  &bt BT_PRV  &bt BT_NXT  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp LG(LS(Z))   &trans     &kp LC(C)     &trans        &trans        &trans  &trans  &trans      &trans      &trans        &trans        &trans
&kp LG(Z)       &kp LG(X)  &kp LG(C)     &kp LG(V)     &trans        &trans  &trans  &trans      &trans      &trans        &trans        &trans
&studio_unlock  &trans     &trans        &trans        &trans        &trans  &trans  &trans      &trans      &trans
            >;

            sensor-bindings = <
                &tab_slide
                &scroll_up_down
                &scroll_up_down
            >;
        };
    };
};
