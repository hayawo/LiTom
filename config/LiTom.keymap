#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

// スクロールのランタイムスケーラ (DYA Studio から実行時に変更できる倍率)。
// LiTom_R.overlay では慣性プロセッサの「上流」に置いてあるので、ここで大きく
// 割ると慣性へ渡る値が 0 に潰れて速度計測が壊れる。固定の縮小は慣性の下流の
// zip_scroll_scaler に任せ、ここは素通し (1:1) を基準にする。
// 注意: この値は NVS に保存されるため、以前 Studio で設定した値があれば
// そちらが優先される。書き込み後に一度 Studio で速度を設定し直すこと。

&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <1>;
};

/ {
    behaviors {
        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        vol_up_down: behavior_sensor_rotate_volume_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_VOL_UP_DOWN";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOLUME_UP>;
            ccw-binding = <&kp C_VOLUME_DOWN>;
            tap-ms = <20>;
        };

        tab_slide: behavior_sensor_rotate_tab_slide {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            label = "ENCODER_TAB_SLIDE";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp LA(LG(RIGHT_ARROW))>;
            ccw-binding = <&kp LA(LG(LEFT_ARROW))>;
            tap-ms = <20>;
        };
    };

    keymap: keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default_layer";
            bindings = <
&kp ESCAPE        &kp PRINTSCREEN
&kp TAB           &kp Q            &kp L         &kp U      &kp COMMA  &kp PERIOD     &kp K_CMENU    &kp F      &kp W     &kp R      &kp Y  &kp P
&kp LEFT_CONTROL  &kp E            &kp I         &kp A      &kp O      &kp MINUS      &kp EQUAL      &kp K      &lt 2 T   &kp N      &kp S  &lt 1 H
&kp LEFT_SHIFT    &kp Z            &kp X         &kp C      &kp V      &kp SEMICOLON  &kp BACKSLASH  &kp G      &kp D     &kp M      &kp J  &lt 3 B
&kp GRAVE         &kp LEFT_WIN     &kp LEFT_ALT  &kp SLASH  &kp SPACE  &lt 4 SQT      &kp BACKSPACE  &kp ENTER  &kp HOME  &lt 5 END
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo 3   &trans    &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans      &trans
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp F12     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        ARROW {
            display-name = "ARROW";
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans          &trans  &oled_mode  &oled_mode  &trans  &trans              &kp LC(UP_ARROW)  &trans               &trans
&trans  &trans  &trans  &trans          &trans  &trans      &trans      &trans  &kp LC(LEFT_ARROW)  &kp UP_ARROW      &kp LC(RIGHT_ARROW)  &trans
&trans  &trans  &trans  &trans          &trans  &trans      &trans      &trans  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &trans
&trans  &trans  &trans  &kp LEFT_SHIFT  &trans  &trans      &trans      &trans  &trans              &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
&trans    &kp SCROLLLOCK
&kp N1    &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp N5       &trans        &trans   &kp NUMBER_6  &kp N7          &kp N8           &kp N9                &kp N0
&kp EXCL  &kp AT_SIGN     &kp HASH      &kp DOLLAR    &kp PERCENT  &kp QUESTION  &trans   &kp CARET     &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans    &trans          &trans        &trans        &trans       &trans        &trans   &kp TILDE     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans    &trans          &trans        &trans        &trans       &trans        &kp DEL  &kp ENTER     &trans          &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        FUNCTION {
            display-name = "FUNCTION";
            bindings = <
&trans        &trans
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans   &trans   &trans
&out OUT_TOG  &oled_power   &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans   &trans   &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp CAPSLOCK  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        // 未使用の予備レイヤー。到達するバインドは意図的に置いていない。
        // 出力先切り替え (&out OUT_TOG) は FUNCTION レイヤーへ移設済み。
        // レイヤー番号を詰めると CALC が 7 -> 6 にずれ、ZMK Studio が
        // NVS に保存したレイヤー設定と食い違うため、枠だけ残している。

        BT {
            display-name = "UNUSED";
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <
                &vol_up_down
                &scroll_up_down
                &scroll_up_down
            >;
        };

        CALC {
            display-name = "CALC";
            bindings = <
&trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp ASTRK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp SLASH  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N0  &kp DOT    &trans
            >;
        };
    };
};
