#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>
#include "LiTom.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        // ディープスリープからの復帰口。これが無いと zmk_pm_suspend_devices() が
        // kscan も停止させてしまい (割り込み無効化 + ピン切断)、起こす手段が無くなる。
        wakeup-source;
        interrupt-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        gpios
            = <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio1 12 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 14 GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            ;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    // 慣性スクロール (iOS風): 玉を弾いて離すとスクロールが減衰しながら続く。
    // https://github.com/mjmjm0101/zmk-input-processor-scroll-inertia
    //
    // 設定値は zen-firmware の input-trackball-pmw3610 スニペットに合わせている。
    // 慣性出力は下流のプロセッサをバイパスしてホストへ直接送られるため、
    // scale / scale-div は下流 &zip_scroll_scaler の引数と一致させること。
    //
    // DYA Studio でのスクロール速度調整は &scroll_runtime_input_processor が
    // 担当する。これは慣性の「上流」に置いてあるので、Studio で倍率を変えると
    // 慣性が計測する速度自体が変わり、実スクロールと慣性が自動で同じだけ
    // スケールする。したがってここでは静的スケーラの分だけを見ればよい。
    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        // 0 = 縦横フリー(zip_xy_to_scroll_mapper の挙動に合わせる), 1 = 縦のみ, 2 = 横のみ
        axis = <0>;
        layer = <2>;

        scale = <1>;
        scale-div = <13>;

        // --- センサーの送信間隔 16ms (62.5Hz) に合わせた値 ---
        // CONFIG_PMW3610_REPORT_INTERVAL_MIN=16 でイベント間隔が 8ms から
        // 16ms になったため、既定値 (125Hz 前提) から調整している。
        // 換算は本家 Wiki の Polling Rate Tuning Starting Points にある
        // 125Hz -> 250Hz の例を逆向きにたどったもの。
        // 送信間隔を 8ms に戻すなら、ここも括弧内の元の値へ戻すこと。

        // 慣性ループの間隔。センサーのレートに合わせる。
        tick = <16>;          // 8ms のときは 8

        // 打ち切り周波数 = stop * scale * (1000 / tick) / scale-div。
        // tick が倍になった分、同じ約 9.6Hz にするには stop も倍にする。
        stop = <2>;           // 8ms のときは 1

        // 指を離したと見なすまでの時間。3 フレーム相当。
        release = <48>;       // 既定 24 (125Hz で 3 フレーム)

        // 1 tick あたりの減衰率。tick が倍になったので、同じ時間で同じだけ
        // 減るように 0.990^2 = 0.980 とする。
        decay-fast = <980>;   // 既定 990
        decay-slow = <980>;   // 既定 990
        decay-tail = <980>;   // 既定 990
        peak-decay = <980>;   // 既定 990

        // --- 発動しやすさの調整 ---
        // 既定 (start=40 / move=80) は 1000cpi 基準。この機体は 600cpi で、
        // Studio 倍率 1.35 を掛けても 810cpi 相当なので約2割厳しい。
        // 「結構強く弾かないと効かない」ため、そこからさらに下げている。
        // 軽く転がしただけで惰性が乗るようなら既定値へ戻すこと。
        // 送信間隔を 16ms にすると 1 イベントあたりの移動量は倍になるが、
        // 本家 Wiki の例でもレートを変えて start / move は据え置いている
        // ので、まずはそのままにする。慣性が出やすくなったと感じたら上げる。
        start = <25>;      // 既定 40
        move = <50>;       // 既定 80

        // armed になるまでに必要なイベント数。時間で揃えるため、イベント
        // 間隔が倍になった分だけ半分にする (7 x 8ms ≒ 4 x 16ms ≒ 60ms)。
        min-events = <4>;  // 8ms のときは 7

        // 速度が小さいほど相対的に強く効く追加ブレーキ。1 tick ごとに引く
        // ので、tick が倍になった分だけ 1 回の量を倍にする。
        friction = <30>;   // 8ms のときは 15

        // COASTING 中に同方向イベントを吸収し続ける上限。これも時間で
        // 揃えるため半分にする (約 400ms 相当)。
        suppress-limit = <25>;  // 既定 50
    };
};

&default_transform {
    col-offset = <6>;
};

&right_encoder {
    status = "okay";
};

// XIAO Plus extra pins from the schematic:
// REA0=D11(P0.15), REA1=D12(P0.19), MOTION=D13(P1.01),
// SDIO=D14(P0.09), SCLK=D15(P0.10), CS=D16(P0.31).

// PMW3610設定 - SPI1を使用
&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    compatible = "nordic,nrf-spim";

    trackball: pd@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        // ZMK が ACTIVE の間はセンサーの省電力降格を止め、初動の遅れを無くす。
        // PMW3610 の降格はセンサー自身の動きだけで決まるため、これが無いと
        // タイピング中にセンサーが REST3 (500ms サンプリング) まで落ち、
        // ボールに触れてから反応するまで最大 0.5 秒かかる。
        // ZMK が IDLE (CONFIG_ZMK_IDLE_TIMEOUT、既定 30 秒) になると
        // ドライバが自動で解除するので、放置時の消費は従来どおり。
        force-awake;
    };
};

&trackball_listener {
    status = "okay";
    input-processors = <&mouse_runtime_input_processor>;

    // レイヤー2 (SCROLL) ではトラックボールをスクロールとして扱う。
    // 並び順が重要:
    //   1. ランタイムスケーラ (Studio 可変) を慣性の「上流」に置く
    //      -> Studio で倍率を変えると慣性の計測速度も一緒に変わり、
    //         実スクロールと慣性が常に一致する
    //   2. 固定の縮小は慣性の「下流」の zip_scroll_scaler にまとめる
    //      -> 慣性はこの比率を scale/scale-div でミラーする
    // ランタイム側を 1:1 にしてあるのは、ここで大きく割ると慣性へ渡る値が
    // 0 に潰れて速度計測が壊れるため (下の &scroll_runtime_input_processor)。
    scroll {
        layers = <2>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_to_scroll_mapper>, <&scroll_runtime_input_processor>, <&scroll_inertia>, <&zip_scroll_scaler 1 13>;
    };
};

// NOTE: &scroll_runtime_input_processor の倍率既定値 (1:1) は LiTom.keymap 側で
// 設定している。ラベルを定義する runtime-input-processor.dtsi を include して
// いるのが keymap で、こちらは overlay より後に処理されるため、overlay では
// ノード上書き構文が使えない (プロパティ内の <&label> 参照は後段で解決される
// ので問題ない)。

// 右手OLED用I2C設定
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

// SPI設定 (PMW3610用) - SPI1を使用してI2C0との競合を回避
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 10)>,
                <NRF_PSEL(SPIM_MOSI, 0, 9)>,
                <NRF_PSEL(SPIM_MISO, 0, 9)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 10)>,
                <NRF_PSEL(SPIM_MOSI, 0, 9)>,
                <NRF_PSEL(SPIM_MISO, 0, 9)>;
            low-power-enable;
        };
    };
};

// xiao_ble board enables i2c1 by default on D4/D5, but SPIM1 and TWI1 share
// the same nRF peripheral instance. Right half uses SPI1 for PMW3610, so keep
// the OLED on I2C0 and disable I2C1.
&i2c1 {
    status = "disabled";
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

&xiao_serial { status = "disabled"; };
&uart0 { status = "disabled";};
