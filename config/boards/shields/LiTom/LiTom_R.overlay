#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>
#include "LiTom.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        zephyr,display = &oled;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        interrupt-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        gpios
            = <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio1 11 GPIO_ACTIVE_HIGH>
            , <&gpio1 12 GPIO_ACTIVE_HIGH>
            , <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 14 GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            ;
    };

    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackball>;
    };

    // 慣性スクロール (iOS風): 玉を弾いて離すとスクロールが減衰しながら続く。
    // https://github.com/mjmjm0101/zmk-input-processor-scroll-inertia
    //
    // 慣性中の出力は下流のプロセッサを通らずホストへ直接送られるため、
    // scale / scale-div には「このノードより後段の合計倍率」を設定する。
    //   zip_scroll_scaler 3 32  ->  3/32
    //   scroll_runtime_input_processor (既定 1/60)
    //   合計 3/(32*60) = 1/640
    // Studio で scroll のランタイム倍率を変えた場合は scale-div も追従させること。
    scroll_inertia: scroll_inertia {
        compatible = "zmk,input-processor-scroll-inertia";
        #input-processor-cells = <0>;

        // 0 = 縦横フリー(現状のスクロール挙動を維持), 1 = 縦のみ, 2 = 横のみ
        axis = <0>;
        layer = <2>;

        scale = <1>;
        scale-div = <640>;

        // PMW3610 は 600cpi なので、既定値(1000cpi 基準)を約 0.6 倍に下げる。
        // 慣性が出過ぎるなら上げる / 弾いても効かないなら下げる。
        start = <25>;
        move = <50>;

        // 停止しきい値。出力周波数 = stop * scale * 125 / scale-div が
        // 約 5Hz を下回るとカクつくため、1/640 では 30 前後が下限。
        stop = <30>;
    };
};

&default_transform {
    col-offset = <6>;
};

&right_encoder {
    status = "okay";
};

// XIAO Plus extra pins from the schematic:
// REA0=D11(P0.15), REA1=D12(P0.19), MOTION=D13(P1.01),
// SDIO=D14(P0.09), SCLK=D15(P0.10), CS=D16(P0.31).

// PMW3610設定 - SPI1を使用
&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    compatible = "nordic,nrf-spim";

    trackball: pd@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

&trackball_listener {
    status = "okay";
    input-processors = <&mouse_runtime_input_processor>;

    // レイヤー2 (SCROLL) ではトラックボールをスクロールとして扱う。
    // 慣性プロセッサに十分な分解能を渡すため、縮小はスクロール変換後
    // (zip_scroll_scaler) にまとめている。
    // 実効倍率 3/32 * 1/60 = 1/640 (旧 1/16 * 1/60 = 1/960 の 1.5倍)。
    scroll {
        layers = <2>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_xy_to_scroll_mapper>, <&scroll_inertia>, <&zip_scroll_scaler 3 32>, <&scroll_runtime_input_processor>;
    };
};

// 右手OLED用I2C設定
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

// SPI設定 (PMW3610用) - SPI1を使用してI2C0との競合を回避
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 10)>,
                <NRF_PSEL(SPIM_MOSI, 0, 9)>,
                <NRF_PSEL(SPIM_MISO, 0, 9)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 10)>,
                <NRF_PSEL(SPIM_MOSI, 0, 9)>,
                <NRF_PSEL(SPIM_MISO, 0, 9)>;
            low-power-enable;
        };
    };
};

// xiao_ble board enables i2c1 by default on D4/D5, but SPIM1 and TWI1 share
// the same nRF peripheral instance. Right half uses SPI1 for PMW3610, so keep
// the OLED on I2C0 and disable I2C1.
&i2c1 {
    status = "disabled";
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <100000>;

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

&xiao_serial { status = "disabled"; };
&uart0 { status = "disabled";};
